# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.bak
.idea/
.vscode/

# Secrets, Environment & Sensitive Configuration
.env
.env.*
*.keystore
*.jks
*.pem
*.key
*.p12
*.pfx

# Local Databases & Logs
*.db
*.sqlite3
*.log

# Caches & Temporary build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.gradle/
build/
*/build/

# Do NOT ignore the official release APKs in releases/
!releases/*.apk
!releases/*.sha256
